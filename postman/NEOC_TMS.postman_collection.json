    {
      "name": "Requests",
      "item": [
        {
          "name": "Create Time Entry Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const d = pm.response.json();",
                  "  const rid = d?.request_id || d?.id;",
                  "  if (rid) pm.environment.set('request_id', rid);",
                  "  const eid = d?.entry_id;",
                  "  if (eid) pm.environment.set('entry_id', eid);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"start_time\": \"2026-05-12T09:00:00+05:00\",\n  \"end_time\": \"2026-05-12T12:30:00+05:00\",\n  \"notes\": \"Initial setup work\",\n  \"priority\": \"medium\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests/time-entry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "time-entry"]
            },
            "description": "Developer only (role_id=3). Creates a pending row in `time_entries` AND a paired row in `requests`. Pass `entry_id` in the body to file an UPDATE request against an existing entry."
          }
        },
        {
          "name": "List Time Entry Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/time-entry?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "time-entry"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Optional. Values: pending | accepted | rejected. Omit to fetch all."
                }
              ]
            },
            "description": "Admin or PM. Returns requests joined with user and task info."
          }
        },
        {
          "name": "Accept Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_comment\": \"Approved.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests/time-entry/{{request_id}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "time-entry", "{{request_id}}", "accept"]
            },
            "description": "Admin or PM. Promotes the linked time entry to `accepted` and stamps the request with reviewer info."
          }
        },
        {
          "name": "Reject Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_comment\": \"Needs more detail in notes.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests/time-entry/{{request_id}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "time-entry", "{{request_id}}", "reject"]
            },
            "description": "Admin or PM. Marks the linked time entry `rejected`."
          }
        }
      ]
    },
